# Copia este archivo a .env. No uses valores reales en el repositorio.
DATABASE_URL=sqlite:///./investiq.db
INVESTIQ_EMAIL=usuario@example.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=25
NVIDIA_MAX_TOKENS=700
HTTP_TIMEOUT_SECONDS=8
TWELVE_DATA_API_KEY=
MARKETAUX_API_KEY=
# Incluye nombre de app y correo real de contacto antes de consultar SEC.
SEC_USER_AGENT=InvestiQ contacto usuario@example.com
